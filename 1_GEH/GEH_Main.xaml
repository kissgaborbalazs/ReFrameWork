                      <CSharpValue x:TypeArguments="x:Object" sap2010:WorkflowViewState.IdRef="CSharpValue`1_4">errorInfo.Exception.GetType().ToString() == "UiPath.Core.BusinessRuleException" ? errorInfo.Exception.Message : errorInfo.Exception.Data["ExceptionInfoStr"].ToString()</CSharpValue>
                    </InArgument>
                  </ui:LogMessage.Message>
                </ui:LogMessage>
              </Sequence>
            </ui:IfElseIfBlock.Then>
